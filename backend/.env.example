# MongoDB
MONGO_URL="mongodb://localhost:27017"
DB_NAME="cleanora"
CORS_ORIGINS="*"

# Admin-Login (beim ersten Start wird der Admin angelegt)
JWT_SECRET="bitte-zufaelligen-64-zeichen-hex-wert-eintragen"
ADMIN_EMAIL="admin@cleanora-reinigung.de"
ADMIN_PASSWORD="sicheres-passwort-hier"

# Verschluesselungs-Schluessel fuer das gespeicherte SMTP-Passwort
# Erzeugen mit: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_ENCRYPTION_KEY="fernet-schluessel-hier"

# Empfaenger der Kontaktanfragen (im Admin-Panel aenderbar)
CONTACT_RECIPIENT="kontak@cleanora-reinigung.de"

# SMTP-Fallback (leer lassen und stattdessen im Admin-Panel konfigurieren)
# Plesk: meist mail.ihre-domain.de, Port 587 (STARTTLS) oder 465 (SSL/TLS -> SMTP_USE_TLS=true, SMTP_START_TLS=false)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_USE_TLS="false"
SMTP_START_TLS="true"
